  "rules": [
    {
      "id": "R001",
      "pattern": "head + pain",
      "keywords": [
        [
          "head"
        ],
        [
          "pain"
        ]
      ],
      "entries": [
        "C006",
        "M006"
      ],
      "message": "Rest, drink water and use a cool cloth. Seek care for sudden severe pain, vision changes or confusion.",
      "emergency": false,
      "warning": false
    },
    {
      "id": "R002",
      "pattern": "head + hit/knock/bang/fell/injury",
      "keywords": [
        [
          "head"
        ],
        [
          "hit",
          "knock",
          "bang",
          "fell",
          "injury"
        ]
      ],
      "entries": [
        "G036"
      ],
      "message": "Stop activity and rest. URGENT: vomiting, drowsiness, a fit or a worsening headache needs hospital.",
      "emergency": false,
      "warning": true
    },
    {
      "id": "R003",
      "pattern": "head + dizzy",
      "keywords": [
        [
          "head"
        ],
        [
          "dizzy"
        ]
      ],
      "entries": [
        "C036",
        "G036"
      ],
      "message": "Sit or lie down and drink water. Get checked if it follows a head knock.",
      "emergency": false,
      "warning": false
    },
    {
      "id": "R004",
      "pattern": "headache/head + stiff + fever",
      "keywords": [
        [
          "headache",
          "head"
        ],
        [
          "stiff"
        ],
        [
          "fever"
        ]
      ],
      "entries": [
        "M007"
      ],
      "message": "Possible meningitis. Go to hospital now.",
      "emergency": true,
      "warning": true
    },
    {
      "id": "R005",
      "pattern": "eye + pain",
      "keywords": [
        [
          "eye"
        ],
        [
          "pain"
        ]
      ],
      "entries": [
        "M047",
        "C015"
      ],
      "message": "Do not rub it. URGENT: an eye injury or loss of vision needs urgent care.",
      "emergency": false,
      "warning": true
    },
    {
      "id": "R006",
      "pattern": "eye + red/itch",
      "keywords": [
        [
          "eye"
        ],
        [
          "red",
          "itch"
        ]
      ],
      "entries": [
        "C015",
        "M044"
      ],
      "message": "Clean the eyelids with cooled boiled water and do not share towels.",
      "emergency": false,
      "warning": false
    },
    {
      "id": "R007",
      "pattern": "eye + blur/vision",
      "keywords": [
        [
          "eye"
        ],
        [
